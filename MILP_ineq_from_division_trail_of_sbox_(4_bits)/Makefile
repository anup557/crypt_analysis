# Makefile for Division Trail H-Representation & Reduction Pipeline (Pure Python/SciPy)

PYTHON ?= /usr/bin/python3

.PHONY: run help

# Default target: run using Python 3
run:
	@$(PYTHON) main.py

help:
	@echo "Usage:"
	@echo "  make        - Runs main.py via Python 3 (requires only scipy & numpy)"
	@echo "  make run    - Same as above"
